# Sec. 3 — variabile de mediu. Copiați în .env și completați. Nu comiteți .env.
DOMAIN=localhost
POSTGRES_PASSWORD=schimba-ma
APP_RW_PASSWORD=schimba-ma-rw
DATABASE_URL=postgres://app_rw:schimba-ma-rw@db:5432/adi
DATABASE_ADMIN_URL=postgres://app_admin:schimba-ma@db:5432/adi
# 32 de octeți base64: openssl rand -base64 32
TOTP_ENC_KEY=
SESSION_PEPPER=
FILE_STORAGE_DIR=/data/files
APP_MODE=demo
TZ_APP=Europe/Bucharest
DEMO_RESET_ENABLED=true
# years (decis la Q1) | months
DEMO_WASTE_SHIFT=years
