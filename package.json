{
  "name": "trash-management",
  "version": "0.1.0",
  "private": true,
  "description": "Registratură și evidența deșeurilor — demo ADI Eco Buzău 2009 (Etapa 1)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:validate": "python3 -I seed/validate_seed.py seed"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@node-rs/argon2": "2.2.2",
    "csv-parse": "7.0.3",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "otpauth": "9.6.0",
    "postgres": "4.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
